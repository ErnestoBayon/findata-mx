# FinData MX — Variables de entorno
# Copia este archivo como .env y llena los valores

# ── Banxico SIE ──────────────────────────────────────────────────────────────
# Registra tu token en: https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=TU_TOKEN_BANXICO_AQUI

# ── INEGI BISE ───────────────────────────────────────────────────────────────
# Registra en: https://www.inegi.org.mx/servicios/api_indicadores.html
INEGI_TOKEN=TU_TOKEN_INEGI_AQUI

# ── Scheduler (opcional) ────────────────────────────────────────────────────
# Frecuencia de actualización: "weekly" o "monthly"
UPDATE_FREQUENCY=monthly

# ── Output ──────────────────────────────────────────────────────────────────
DATA_OUTPUT_DIR=./data
